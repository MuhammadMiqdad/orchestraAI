# Port server HTTP lokal
PORT=4174

# Opsional: kalau diisi, endpoint /api/generate dan /api/knowledge/* akan
# mewajibkan header `X-API-Key` dengan nilai yang sama persis dengan ini.
# Kosongkan saat development lokal kalau belum butuh auth.
API_KEY=

# Hanya dipakai kalau engine HTTP "perplexity" ditambahkan ke config.json
# di v2 (lihat README). TIDAK dipakai sama sekali di v1 (3 engine CLI saja).
PERPLEXITY_API_KEY=
